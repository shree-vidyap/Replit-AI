# ---- Core ----
DATABASE_URL="postgresql://postgres:pass@localhost:5432/postgres"
APP_URL="http://localhost:3000"
AUTH_SECRET="generate-with: npx auth secret   (or any long random string)"

# ---- AI ----
OPENAI_API_KEY="your key here"
OPENAI_MODEL="gpt-4o-mini"
ALLOW_ANONYMOUS_AI="true"   # lets the /workspace/local page use AI without login

# ---- Redis (queues + rate limits) / S3-compatible storage (MinIO locally) ----
REDIS_URL="redis://localhost:6379"
S3_ENDPOINT="http://localhost:9000"
S3_BUCKET="ai-builder"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"

# ---- Security ----
ENCRYPTION_KEY="any-long-random-string-used-to-encrypt-env-vars-and-tokens"

# ---- Deployed sites: http://<slug>.localhost:3000 ----
SITES_DOMAIN="localhost"
SITES_SCHEME="http"
SITES_PORT="3000"
APP_HOSTS="localhost:3000,127.0.0.1:3000"

# ---- Stripe billing (optional) ----
STRIPE_SECRET_KEY=""
STRIPE_PRICE_PRO=""
STRIPE_WEBHOOK_SECRET=""

# ---- Mobile builds via EAS (optional, paid feature) ----
EXPO_TOKEN=""

# ---- Monitoring (optional) ----
SENTRY_DSN=""
OTEL_ENABLED="false"
